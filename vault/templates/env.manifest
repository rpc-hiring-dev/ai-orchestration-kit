# env.manifest: every key and setting this product needs. Names only, never values.
# /kickoff copies this to the repo root as env.manifest and fills it from the master plan's
# "Integrations and accounts". Check it with: python3 tools/preflight.py  (and --live before go-live)
#
# NAME                where=...              extras                 # what it is, and where the owner gets it
# where: session = agents need it here (cloud environment or .env). Anything else (hosting,
#        supabase, google, ...) is a setting the owner confirms by hand in that service.
# extras: also=OTHER_NAME, pattern=REGEX, optional, live (decides where real data comes from)

# Alerts (kit defaults)
TELEGRAM_BOT_TOKEN    where=session also=TELEGRAM_BOT_API_KEY pattern=^\d+:          # @BotFather token. Check the bot's @name with getMe; a typo'd bot is easy to miss
TELEGRAM_CHAT_ID      where=session          pattern=^-?\d+$ optional # python3 tools/notify.py --find-chat after messaging the bot

# Example product settings: replace with this product's
# SUPABASE_URL          where=session,hosting  pattern=^https://.*\.supabase\.co
# SUPABASE_ANON_KEY     where=session,hosting
# SUPABASE_SERVICE_ROLE_KEY where=session,hosting
# SUPABASE_ACCESS_TOKEN where=session          # Management API: how cloud sessions run migrations
# SMTP_FOR_SIGN_IN      where=supabase         # custom SMTP before inviting users; the built-in sender allows ~2 emails/hour
# DATA_SOURCE           where=session,hosting  live   # e.g. sheets in production, fixture only in tests
